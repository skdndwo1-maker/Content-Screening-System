# ContentGuard — 로컬 환경 변수 (복사해서 .env.local 로 저장)
# .env.local 은 .gitignore 에 포함되어 Git에 올라가지 않습니다.

# Google AI Studio (https://aistudio.google.com/apikey) 에서 발급받은 키
GEMINI_API_KEY=your_api_key_here

# 1차 판정 모델 — 코드 수정 없이 이 값만 바꾸면 교체됩니다.
GEMINI_MODEL=gemini-3.8-flash

# 선택: 1차 실패 시 시도할 모델 (콤마 구분)
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite

# 선택: 주의·위험·미검증 항목 2차 재판정 모델. 비우면 건너뜀.
# GEMINI_REVIEW_MODEL=

# RAG 임베딩 모델 (교체 시 npm run ingest:knowledge 로 재적재)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# thinking 레벨: low | medium | high
GEMINI_THINKING_LEVEL=medium

# 외부 소스 기능 플래그. false면 키가 있어도 호출하지 않습니다.
GROK_ENABLED=false
NAVER_ENABLED=false
GEMINI_SEARCH_ENABLED=true
# GEMINI_SEARCH_MODEL=
GEMINI_SEARCH_MAX_QUERIES=3
GEMINI_SEARCH_MAX_LINKS=5
EXTERNAL_SOURCE_TIMEOUT_MS=20000

# 아직 없으면 검수 시 해당 소스는 "미연동"으로 건너뜁니다.
# GROK_API_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
